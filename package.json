{
  "name": "proofofship",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ProofOfShip - public build commitments judged by GenLayer AI validators against locked acceptance criteria",
  "scripts": {
    "deploy:studionet": "node scripts/deploy.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:changed": "node scripts/e2e-changed.mjs",
    "results": "node scripts/results.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "demo:browser": "node scripts/browser-demo.mjs",
    "lint:contract": "genvm-lint check contracts/proofofship.py",
    "test:contract": "pytest tests/direct/ -v",
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "genlayer-js": "1.1.8"
  },
  "devDependencies": {
    "playwright-core": "1.49.1"
  }
}
